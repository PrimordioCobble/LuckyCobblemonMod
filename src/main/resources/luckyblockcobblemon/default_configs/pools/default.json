{
  "configVersion": 2,
  "_comment": "GLOBAL default Lucky Block pool. This is the public/default distribution for the mod and is NOT Kanto-only. Edit this file only if you want to customize the regular Lucky Block.",
  "_note": [
    "Creative-mode activation is controlled by config/luckyblockcobblemon/settings.json.",
    "This pool controls regular Lucky Block events only."
  ],
  "__note_legendarySpawn": "Optional helper for regular lucky blocks. Set legendarySpawn.enabled to true to let the regular block spawn legendary Pokemon without manually creating a luckPool event.",
  "legendarySpawn": {
    "enabled": false,
    "chance": 0.25,
    "minLevel": 50,
    "maxLevel": 70,
    "shinyChance": 0.02,
    "species": [
      "articuno",
      "zapdos",
      "moltres",
      "mewtwo",
      "mew"
    ]
  },
  "__note_leveling_strategy": [
    "There are 3 ways to define Pokémon level for spawn events.",
    "Applies only to: 'cobblemonp', 'shiny_cobblemonp', 'random_cobblemonp', and 'multi_cobblemonp'.",
    "1. minLevel / maxLevel → Defined directly in the event.",
    "   Example: minLevel: 10, maxLevel: 50.",
    "   If present, this is always used.",
    "2. timeLeveling → If min/max are missing, uses world day ranges to decide.",
    "   Example: Days 0–20 = 90% chance for level 1–40, etc.",
    "3. levelWeighting → Global fallback level table.",
    "Priority:",
    "   1) minLevel/maxLevel (per event)",
    "   2) timeLeveling (based on world days)",
    "   3) levelWeighting (default)",
    "⚠️ Works only for specific Pokémon spawn types."
  ],
